/* General Styling */
QWidget {
    font-family: "Segoe UI", "Cantarell", "sans-serif";
    font-size: 14px;
}

/* Main Window */
QMainWindow {
    background-color: #23272e; /* Fallback for dark theme */
}

/* GroupBox and Frames */
QGroupBox {
    font-weight: bold;
    font-size: 16px;
    border: 1px solid #3c424d;
    border-radius: 6px;
    margin-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    left: 10px;
}

/* Buttons */
QPushButton {
    min-height: 28px;
    padding: 0 15px;
    border-radius: 4px;
    border: 1px solid #444a54;
    background-color: #2c313a;
}

QPushButton:hover {
    background-color: #3c424d;
}

QPushButton:pressed {
    background-color: #252930;
}

QPushButton:checked {
    background-color: #0078d7;
    border-color: #005a9e;
}

/* LineEdits, ComboBoxes */
QLineEdit, QComboBox {
    min-height: 28px;
    padding: 0 8px;
    border: 1px solid #444a54;
    border-radius: 4px;
    background-color: #1c1f24;
}

QComboBox::drop-down {
    border-left: 1px solid #444a54;
}

/* TableView */
QTableView {
    border: 1px solid #3c424d;
    gridline-color: #3c424d;
    background-color: #1c1f24;
    selection-background-color: #0078d7;
}

QHeaderView::section {
    background-color: #2c313a;
    padding: 4px;
    border: 1px solid #3c424d;
    font-weight: bold;
}

/* TabWidget */
QTabWidget::pane {
    border: 1px solid #3c424d;
    border-top: none;
}

QTabBar::tab {
    background: #2c313a;
    border: 1px solid #3c424d;
    border-bottom: none;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #23272e; /* Same as window background */
    border-color: #3c424d;
    border-bottom-color: #23272e; /* Hide bottom border */
}

QTabBar::tab:!selected:hover {
    background: #3c424d;
}

/* ScrollBar */
QScrollBar:vertical {
    border: none;
    background: #23272e;
    width: 10px;
    margin: 0px 0px 0px 0px;
}
QScrollBar::handle:vertical {
    background: #444a54;
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* Badge for 'Stale Cache' */
#StaleBadge {
    background-color: #c8a032; /* Amber */
    color: #1c1f24;
    font-weight: bold;
    padding: 3px 8px;
    border-radius: 8px;
}